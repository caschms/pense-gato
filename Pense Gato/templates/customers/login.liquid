{% layout 'theme' %}

<div class="page-wrapper">
  <div class="container">
    <h1>Entrar</h1>

    <form method="post" action="/account/login" id="customer_login">
      <label for="CustomerEmail">Email</label>
      <input type="email" name="customer[email]" id="CustomerEmail" required>

      <label for="CustomerPassword">Senha</label>
      <input type="password" name="customer[password]" id="CustomerPassword" required>

      <button type="submit">Entrar</button>
    </form>

    <p><a href="/account/register">Criar conta</a> | <a href="/account/recover">Esqueci minha senha</a></p>
  </div>
</div>
<div class="btn-back">
  <a href="javascript:history.back()" class="btn-theme">⬅ Voltar</a>
</div>
