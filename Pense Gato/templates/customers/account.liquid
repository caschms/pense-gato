{% layout 'theme' %}

<div class="page-wrapper">
  <div class="container">
    <h1>Minha conta</h1>

    <p>Bem-vindo, {{ customer.first_name }} {{ customer.last_name }}!</p>

    <h2>Pedidos recentes</h2>
    {% if customer.orders.size > 0 %}
      <ul>
        {% for order in customer.orders %}
          <li>
            Pedido #{{ order.name }} – {{ order.created_at | date: "%d/%m/%Y" }} – {{ order.total_price | money }}
            <a href="{{ order.customer_url }}">Ver detalhes</a>
          </li>
        {% endfor %}
      </ul>
    {% else %}
      <p>Você ainda não fez nenhum pedido.</p>
    {% endif %}

    <p><a href="/account/logout">Sair</a></p>
  </div>
</div>
<div class="btn-back">
  <a href="javascript:history.back()" class="btn-theme">⬅ Voltar</a>
</div>
