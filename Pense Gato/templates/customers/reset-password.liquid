{% layout 'theme' %}

<div class="page-wrapper">
  <div class="container">
    <h1>Redefinir senha</h1>

    <form method="post" action="/account/reset_password" id="reset_password">
      <input type="hidden" name="customer[email]" value="{{ email }}">
      
      <label for="ResetPassword">Nova senha</label>
      <input type="password" name="customer[password]" id="ResetPassword" required>

      <label for="PasswordConfirmation">Confirme a senha</label>
      <input type="password" name="customer[password_confirmation]" id="PasswordConfirmation" required>

      <button type="submit">Redefinir senha</button>
    </form>
  </div>
</div>
<div class="btn-back">
  <a href="javascript:history.back()" class="btn-theme">⬅ Voltar</a>
</div>
