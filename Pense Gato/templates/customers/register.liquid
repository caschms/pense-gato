{% layout 'theme' %}

<div class="page-wrapper">
  <div class="container">
    <h1>Criar conta</h1>

    <form method="post" action="/account" id="create_customer">
      <label for="FirstName">Nome</label>
      <input type="text" name="customer[first_name]" id="FirstName" required>

      <label for="LastName">Sobrenome</label>
      <input type="text" name="customer[last_name]" id="LastName" required>

      <label for="Email">Email</label>
      <input type="email" name="customer[email]" id="Email" required>

      <label for="CreatePassword">Senha</label>
      <input type="password" name="customer[password]" id="CreatePassword" required>

      <button type="submit">Criar conta</button>
    </form>
  </div>
</div>
<div class="btn-back">
  <a href="javascript:history.back()" class="btn-theme">⬅ Voltar</a>
</div>
