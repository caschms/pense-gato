{% layout 'theme' %}

<div class="page-wrapper">
  <div class="container">
    <h1 class="page-title">Resultados da busca</h1>

    {% if search.performed %}
      {% if search.results_count > 0 %}
        <p>Encontramos {{ search.results_count }} resultado(s) para: <strong>{{ search.terms }}</strong></p>
        <ul class="search-results">
          {% for item in search.results %}
            <li class="search-item">
              <a href="{{ item.url }}">
                {{ item.title }}
              </a>
              {% if item.object_type == 'product' %}
                - {{ item.price | money }}
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% else %}
        <p>Nenhum resultado encontrado para <strong>{{ search.terms }}</strong>.</p>
      {% endif %}
    {% else %}
      <p>Digite algo no campo de busca para começar.</p>
    {% endif %}
  </div>
</div>
