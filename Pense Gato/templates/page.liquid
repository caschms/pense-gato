{% comment %}
Template de página padrão
Mostra o conteúdo da página criada no Admin (ex.: Sobre, Contato)
{% endcomment %}

{% layout 'theme' %}

<div class="page-wrapper">
  <div class="container">
    <h1 class="page-title">{{ page.title }}</h1>
    <div class="page-content rte">
      {{ page.content }}
    </div>
  </div>
</div>
<div class="btn-back">
  <a href="javascript:history.back()" class="btn-theme">⬅ Voltar</a>
</div>
