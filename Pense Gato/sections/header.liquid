{%- comment -%}
  Header da Pense Gato
  Inclui logo com mascote, navegação, busca e ações do usuário
{%- endcomment -%}

<header class="header" id="shopify-section-header">
  <div class="header-wrapper">
    <div class="container">
      <div class="header-content">
        
        <!-- Logo da Pense Gato com Mascote -->
        <div class="header-logo">
          <a href="{{ routes.root_url }}" class="logo-link">
            <div class="logo-mascot">
             <img 
  src="https://cdn.shopify.com/s/files/1/0781/1681/5088/files/sf_simbolo_isolado_final.png?v=1754587722" 
  alt="{{ shop.name }}" 
>
            </div>
            <div class="logo-text">
              <span class="brand-tagline">{{ settings.brand_tagline | default: 'Pensado por gatos, aprovado por tutores' }}</span>
            </div>
          </a>
        </div>

        <!-- Navegação Principal -->
        <nav class="header-nav" role="navigation">
          <ul class="nav-list">
            <li class="nav-item">
              <a href="{{ routes.root_url }}" class="nav-link {% if template == 'index' %}active{% endif %}">
                Início
              </a>
            </li>
            <li class="nav-item">
              <a href="/collections/all" class="nav-link">
                Produtos
              </a>
            </li>
            <li class="nav-item dropdown">
              <a href="#" class="nav-link dropdown-toggle">
                Categorias
                <svg class="dropdown-icon" width="12" height="12" viewBox="0 0 12 12" fill="none">
                  <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
                </svg>
              </a>
              <div class="dropdown-menu">
                {% for collection in collections %}
                  {% unless collection.handle == 'all' %}
                    <a href="{{ collection.url }}" class="dropdown-item">
                      {{ collection.title }}
                      <span class="item-count">({{ collection.products_count }})</span>
                    </a>
                  {% endunless %}
                {% endfor %}
              </div>
            </li>
            <li class="nav-item">
              <a href="{{ pages[section.settings.page_sobre].url 
             | default: pages.sobre.url 
             | default: '/pages/sobre' }}" 
   class="nav-link">Sobre Nós</a>
            </li>
            <li class="nav-item">
              <a href="{{ pages[section.settings.page_contato].url 
             | default: pages.contato.url 
             | default: '/pages/contato' }}" 
   class="nav-link">Contato</a>
            </li>
          </ul>
        </nav>

        <!-- Ações do Header -->
        <div class="header-actions">
          
          <!-- Busca -->
          <div class="search-wrapper">
            <form action="{{ routes.search_url }}" method="get" class="search-form">
              <div class="search-input-wrapper">
                <input 
                  type="search" 
                  name="q" 
                  class="search-input"
                  placeholder="Buscar produtos..."
                  value="{{ search.terms | escape }}"
                  autocomplete="off"
                >
                <button type="submit" class="search-button">
                  <svg width="20" height="20" viewBox="0 0 20 20" fill="none">
                    <path d="M19 19L13 13M15 8C15 11.866 11.866 15 8 15C4.134 15 1 11.866 1 8C1 4.134 4.134 1 8 1C11.866 1 15 4.134 15 8Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
                  </svg>
                </button>
              </div>
            </form>
          </div>

          <!-- Conta do Usuário -->
          <a href="{{ routes.account_url }}" class="header-icon" title="Minha Conta">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </a>

          <!-- Favoritos -->
          <a href="{{ pages.favoritos.url | default: '/pages/favoritos' }}" class="header-icon" title="Favoritos">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M20.84 4.61C20.3292 4.099 19.7228 3.69364 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69364 13.5708 4.099 13.06 4.61L12 5.67L10.94 4.61C9.9083 3.5783 8.50903 2.9987 7.05 2.9987C5.59096 2.9987 4.19169 3.5783 3.16 4.61C2.1283 5.6417 1.5487 7.04097 1.5487 8.5C1.5487 9.95903 2.1283 11.3583 3.16 12.39L4.22 13.45L12 21.23L19.78 13.45L20.84 12.39C21.351 11.8792 21.7563 11.2728 22.0329 10.6053C22.3095 9.93789 22.4518 9.22248 22.4518 8.5C22.4518 7.77752 22.3095 7.06211 22.0329 6.39467C21.7563 5.72723 21.351 5.1208 20.84 4.61V4.61Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="badge" id="favorites-count">0</span>
          </a>

          <!-- Carrinho -->
          <a href="{{ routes.cart_url }}" class="header-icon cart-icon" title="Carrinho">
            <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
              <path d="M9 22C9.55228 22 10 21.5523 10 21C10 20.4477 9.55228 20 9 20C8.44772 20 8 20.4477 8 21C8 21.5523 8.44772 22 9 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M20 22C20.5523 22 21 21.5523 21 21C21 20.4477 20.5523 20 20 20C19.4477 20 19 20.4477 19 21C19 21.5523 19.4477 22 20 22Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
              <path d="M1 1H5L7.68 14.39C7.77144 14.8504 8.02191 15.264 8.38755 15.5583C8.75318 15.8526 9.2107 16.009 9.68 16H19.4C19.8693 16.009 20.3268 15.8526 20.6925 15.5583C21.0581 15.264 21.3086 14.8504 21.4 14.39L23 6H6" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
            <span class="badge" id="cart-count">{{ cart.item_count }}</span>
          </a>

          <!-- Menu Mobile -->
          <button class="mobile-menu-toggle" aria-label="Abrir menu">
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
            <span class="hamburger-line"></span>
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- Menu Mobile -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-content">
      <div class="mobile-menu-header">
        <div class="mobile-logo">
<img 
  src="https://cdn.shopify.com/s/files/1/0781/1681/5088/files/simbolo_isolado_final.png?v=1754585369" 
  alt="{{ shop.name }}" 
  width="40"  <!-- Ajuste conforme necessário para mobile -->
>
            <span>{{ shop.name }}</span>
        </div>
        <button class="mobile-menu-close" aria-label="Fechar menu">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none">
            <path d="M18 6L6 18M6 6L18 18" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
        </button>
      </div>
      
      <nav class="mobile-nav">
        <a href="{{ routes.root_url }}" class="mobile-nav-link">Início</a>
        <a href="{{ collections['all'].url }}" class="mobile-nav-link">Produtos</a>
        
        <div class="mobile-dropdown">
          <button class="mobile-dropdown-toggle">
            Categorias
            <svg width="12" height="12" viewBox="0 0 12 12" fill="none">
              <path d="M3 4.5L6 7.5L9 4.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/>
            </svg>
          </button>
          <div class="mobile-dropdown-content">
            {% for collection in collections %}
              {% unless collection.handle == 'all' %}
                <a href="{{ collection.url }}" class="mobile-dropdown-item">
                  {{ collection.title }}
                </a>
              {% endunless %}
            {% endfor %}
          </div>
        </div>
        
        <a href="{{ pages[section.settings.page_sobre].url 
             | default: pages.sobre.url 
             | default: '/pages/sobre' }}" 
   class="mobile-nav-link">Sobre Nós</a>
        <a href="{{ pages[section.settings.page_contato].url 
             | default: pages.contato.url 
             | default: '/pages/contato' }}" 
   class="mobile-nav-link">Contato</a>
      </nav>

      <div class="mobile-menu-actions">
        <a href="{{ routes.account_url }}" class="mobile-action-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M20 21V19C20 17.9391 19.5786 16.9217 18.8284 16.1716C18.0783 15.4214 17.0609 15 16 15H8C6.93913 15 5.92172 15.4214 5.17157 16.1716C4.42143 16.9217 4 17.9391 4 19V21" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
            <path d="M12 11C14.2091 11 16 9.20914 16 7C16 4.79086 14.2091 3 12 3C9.79086 3 8 4.79086 8 7C8 9.20914 9.79086 11 12 11Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Minha Conta
        </a>
        <a href="{{ pages.favoritos.url | default: '/pages/favoritos' }}" class="mobile-action-btn">
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none">
            <path d="M20.84 4.61C20.3292 4.099 19.7228 3.69364 19.0554 3.41708C18.3879 3.14052 17.6725 2.99817 16.95 2.99817C16.2275 2.99817 15.5121 3.14052 14.8446 3.41708C14.1772 3.69364 13.5708 4.099 13.06 4.61L12 5.67L10.94 4.61C9.9083 3.5783 8.50903 2.9987 7.05 2.9987C5.59096 2.9987 4.19169 3.5783 3.16 4.61C2.1283 5.6417 1.5487 7.04097 1.5487 8.5C1.5487 9.95903 2.1283 11.3583 3.16 12.39L4.22 13.45L12 21.23L19.78 13.45L20.84 12.39C21.351 11.8792 21.7563 11.2728 22.0329 10.6053C22.3095 9.93789 22.4518 9.22248 22.4518 8.5C22.4518 7.77752 22.3095 7.06211 22.0329 6.39467C21.7563 5.72723 21.351 5.1208 20.84 4.61V4.61Z" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"/>
          </svg>
          Favoritos
        </a>
      </div>
    </div>
  </div>
</header>

<style>
/* Header Styles */
.header {
  background: var(--white);
  border-bottom: 1px solid var(--border-color);
  position: sticky;
  top: 0;
  z-index: 1000;
  box-shadow: var(--shadow);
}

.header-content {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16px 0;
  gap: 32px;
}

/* Logo */
.logo-link {
  display: flex;
  align-items: center;
  gap: 12px;
  text-decoration: none;
  color: var(--secondary-color);
}

.logo-text {
  display: flex;
  flex-direction: column;
}

.brand-name {
  font-size: 24px;
  font-weight: 800;
  color: var(--secondary-color);
  line-height: 1;
}

.brand-tagline {
  font-size: 12px;
  font-weight: 400;
  color: var(--primary-color);
  line-height: 1;
}

/* Navegação */
.header-nav {
  flex: 1;
  display: flex;
  justify-content: center;
}

.nav-list {
  display: flex;
  list-style: none;
  gap: 32px;
  margin: 0;
  padding: 0;
}

.nav-link {
  font-weight: 600;
  color: var(--secondary-color);
  text-decoration: none;
  padding: 8px 0;
  position: relative;
  transition: var(--transition);
  display: flex;
  align-items: center;
  gap: 4px;
}

.nav-link:hover,
.nav-link.active {
  color: var(--primary-color);
}

.nav-link.active::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 2px;
  background: var(--primary-color);
  border-radius: 1px;
}

/* Dropdown */
.dropdown {
  position: relative;
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  background: var(--white);
  border: 1px solid var(--border-color);
  border-radius: var(--border-radius);
  box-shadow: var(--shadow-hover);
  min-width: 200px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: var(--transition);
  z-index: 1001;
}

.dropdown:hover .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 16px;
  color: var(--secondary-color);
  text-decoration: none;
  transition: var(--transition);
  border-bottom: 1px solid var(--border-color);
}

.dropdown-item:last-child {
  border-bottom: none;
}

.dropdown-item:hover {
  background: var(--light-gray);
  color: var(--primary-color);
}

.item-count {
  font-size: 12px;
  color: var(--primary-color);
  background: rgba(143, 211, 199, 0.2);
  padding: 2px 6px;
  border-radius: 10px;
}

/* Ações do Header */
.header-actions {
  display: flex;
  align-items: center;
  gap: 16px;
}

.search-form {
  position: relative;
}

.search-input-wrapper {
  position: relative;
  display: flex;
  align-items: center;
}

.search-input {
  width: 280px;
  padding: 12px 16px;
  padding-right: 48px;
  border: 2px solid var(--border-color);
  border-radius: var(--border-radius);
  font-family: var(--font-family);
  font-size: 14px;
  transition: var(--transition);
}

.search-input:focus {
  outline: none;
  border-color: var(--primary-color);
  box-shadow: 0 0 0 3px rgba(143, 211, 199, 0.1);
}

.search-button {
  position: absolute;
  right: 8px;
  background: none;
  border: none;
  color: var(--secondary-color);
  cursor: pointer;
  padding: 8px;
  border-radius: 6px;
  transition: var(--transition);
}

.search-button:hover {
  color: var(--primary-color);
  background: rgba(143, 211, 199, 0.1);
}

/* Ícones do Header */
.header-icon {
  position: relative;
  color: var(--secondary-color);
  text-decoration: none;
  padding: 8px;
  border-radius: 8px;
  transition: var(--transition);
}

.header-icon:hover {
  color: var(--primary-color);
  background: rgba(143, 211, 199, 0.1);
}

.badge {
  position: absolute;
  top: 0;
  right: 0;
  background: var(--accent-color);
  color: var(--white);
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 10px;
  min-width: 18px;
  height: 18px;
  display: flex;
  align-items: center;
  justify-content: center;
  transform: translate(25%, -25%);
}

/* Menu Mobile */
.mobile-menu-toggle {
  display: none;
  flex-direction: column;
  background: none;
  border: none;
  cursor: pointer;
  padding: 8px;
  gap: 4px;
}

.hamburger-line {
  width: 24px;
  height: 2px;
  background: var(--secondary-color);
  border-radius: 1px;
  transition: var(--transition);
}

.mobile-menu {
  display: none;
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100vh;
  background: rgba(0, 0, 0, 0.5);
  z-index: 2000;
}

.mobile-menu-content {
  position: absolute;
  right: 0;
  top: 0;
  width: 300px;
  height: 100%;
  background: var(--white);
  padding: 24px;
  transform: translateX(100%);
  transition: var(--transition);
}

.mobile-menu.active .mobile-menu-content {
  transform: translateX(0);
}

.mobile-menu-header {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 32px;
  padding-bottom: 16px;
  border-bottom: 1px solid var(--border-color);
}

.mobile-logo {
  display: flex;
  align-items: center;
  gap: 8px;
  font-weight: 700;
  color: var(--secondary-color);
}

.mobile-menu-close {
  background: none;
  border: none;
  cursor: pointer;
  color: var(--secondary-color);
  padding: 4px;
}

.mobile-nav {
  display: flex;
  flex-direction: column;
  gap: 8px;
}

.mobile-nav-link {
  padding: 12px 0;
  color: var(--secondary-color);
  text-decoration: none;
  font-weight: 600;
  border-bottom: 1px solid var(--border-color);
  transition: var(--transition);
}

.mobile-nav-link:hover {
  color: var(--primary-color);
}

.mobile-dropdown-toggle {
  width: 100%;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  background: none;
  border: none;
  border-bottom: 1px solid var(--border-color);
  font-weight: 600;
  color: var(--secondary-color);
  cursor: pointer;
  text-align: left;
}

.mobile-dropdown-content {
  padding-left: 16px;
  max-height: 0;
  overflow: hidden;
  transition: var(--transition);
}

.mobile-dropdown.active .mobile-dropdown-content {
  max-height: 300px;
}

.mobile-dropdown-item {
  display: block;
  padding: 8px 0;
  color: var(--secondary-color);
  text-decoration: none;
  font-size: 14px;
  transition: var(--transition);
}

.mobile-dropdown-item:hover {
  color: var(--primary-color);
}

.mobile-menu-actions {
  margin-top: 32px;
  padding-top: 24px;
  border-top: 1px solid var(--border-color);
  display: flex;
  flex-direction: column;
  gap: 12px;
}

.mobile-action-btn {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 12px;
  color: var(--secondary-color);
  text-decoration: none;
  border-radius: var(--border-radius);
  transition: var(--transition);
}

.mobile-action-btn:hover {
  background: var(--light-gray);
  color: var(--primary-color);
}

/* Responsividade */
@media (max-width: 1024px) {
  .search-input {
    width: 200px;
  }
  
  .nav-list {
    gap: 24px;
  }
}

@media (max-width: 768px) {
  .header-nav,
  .search-wrapper {
    display: none;
  }
  
  .mobile-menu-toggle {
    display: flex;
  }
  
  .mobile-menu.active {
    display: block;
  }
  
  .header-actions {
    gap: 12px;
  }
  
  .brand-name {
    font-size: 20px;
  }
  
  .brand-tagline {
    font-size: 10px;
  }
}

@media (max-width: 480px) {
  .header-content {
    padding: 12px 0;
  }
  
  .brand-name {
    font-size: 18px;
  }
  
  .logo-text {
    display: none;
  }
}

/* Ajuste do Logo - Pense Gato */
.header__logo img {
  max-width: 120px;
  max-height: 60px;
  object-fit: contain;
}
@media (max-width: 768px) {
  .header__logo img {
    max-width: 90px;
  }
}

.dropdown {
  position: relative;
}

.dropdown-menu {
  position: absolute;
  top: 100%;
  left: 0;
  background: white;
  border: 1px solid #ddd;
  border-radius: 4px;
  box-shadow: 0 2px 8px rgba(0,0,0,0.1);
  min-width: 200px;
  opacity: 0;
  visibility: hidden;
  transform: translateY(-10px);
  transition: all 0.3s ease;
  z-index: 1000;
}

.dropdown.active .dropdown-menu {
  opacity: 1;
  visibility: visible;
  transform: translateY(0);
}

.dropdown-item {
  display: block;
  padding: 0.5rem 1rem;
  color: #333;
  text-decoration: none;
  border-bottom: 1px solid #eee;
}

.dropdown-item:hover {
  background-color: #f8f9fa;
}

.dropdown-item:last-child {
  border-bottom: none;
}
</style>

{% schema %}
{
  "name": "Header",
  "settings": [
    {
      "type": "header",
      "content": "Configurações do Header"
    },
    {
      "type": "page",
      "id": "page_sobre",
      "label": "Página 'Sobre Nós'"
    },
    {
      "type": "page",
      "id": "page_contato",
      "label": "Página 'Contato'"
    },
    {
      "type": "checkbox",
      "id": "sticky_header",
      "label": "Header Fixo",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_search",
      "label": "Mostrar Busca",
      "default": true
    }
  ]
}
{% endschema %}

