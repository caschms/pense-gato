<section class="newsletter-section" style="--bg-color: {{ section.settings.bg_color | default: '#ffe0cc' }}; --btn-color: {{ section.settings.btn_color | default: '#a0522d' }};">
  <div class="newsletter-container page-width">
    <div class="newsletter-content">
      {% if section.settings.titulo != blank %}
        <h2 class="newsletter-title">{{ section.settings.titulo }}</h2>
      {% endif %}
      
      {% if section.settings.subtitulo != blank %}
        <p class="newsletter-subtitle">{{ section.settings.subtitulo }}</p>
      {% endif %}
      
      {% form 'customer', class: 'newsletter-form' %}
        <input type="hidden" name="contact[tags]" value="newsletter">
        <div class="input-group">
          <input 
            type="email" 
            name="contact[email]" 
            class="newsletter-input" 
            placeholder="{{ section.settings.placeholder | default: 'Seu e-mail' }}" 
            required
            aria-label="Digite seu e-mail"
          >
          <button type="submit" class="newsletter-button">
            {{ section.settings.btn_text | default: 'Assinar' }}
          </button>
        </div>
        
        {% if form.errors %}
          <div class="newsletter-error">
            {{ form.errors | default_errors }}
          </div>
        {% endif %}
        
        {% if form.posted_successfully? %}
          <div class="newsletter-success">
            {{ section.settings.success_message | default: 'Obrigado por se inscrever!' }}
          </div>
        {% endif %}
      {% endform %}
    </div>
  </div>
</section>

<style>
  .newsletter-section {
    padding: 3rem 1rem;
    background-color: var(--bg-color);
  }
  
  .newsletter-container {
    max-width: 600px;
    margin: 0 auto;
  }
  
  .newsletter-title {
    font-size: clamp(1.5rem, 3vw, 2rem);
    margin-bottom: 0.5rem;
    color: {{ section.settings.text_color | default: '#333' }};
  }
  
  .newsletter-subtitle {
    margin-bottom: 1.5rem;
    color: {{ section.settings.text_color | default: '#333' }};
    opacity: 0.9;
  }
  
  .newsletter-form {
    margin-top: 1.5rem;
  }
  
  .input-group {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.5rem;
  }
  
  .newsletter-input {
    padding: 0.75rem 1rem;
    width: min(100%, 300px);
    border: 1px solid #ddd;
    border-radius: 4px;
    font-size: 1rem;
  }
  
  .newsletter-button {
    padding: 0.75rem 1.5rem;
    background-color: var(--btn-color);
    color: white;
    border: none;
    border-radius: 4px;
    font-size: 1rem;
    cursor: pointer;
    transition: all 0.3s ease;
  }
  
  .newsletter-button:hover {
    opacity: 0.9;
    transform: translateY(-1px);
  }
  
  .newsletter-error {
    color: #d32f2f;
    margin-top: 1rem;
  }
  
  .newsletter-success {
    color: #388e3c;
    margin-top: 1rem;
    font-weight: 500;
  }
  
  @media (max-width: 480px) {
    .input-group {
      flex-direction: column;
      align-items: center;
    }
    
    .newsletter-input,
    .newsletter-button {
      width: 100%;
    }
  }
</style>

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    {
      "type": "text",
      "id": "titulo",
      "label": "Título",
      "default": "Assine nossa newsletter"
    },
    {
      "type": "text",
      "id": "subtitulo",
      "label": "Subtítulo",
      "default": "Receba novidades e promoções exclusivas"
    },
    {
      "type": "text",
      "id": "placeholder",
      "label": "Texto do campo de e-mail",
      "default": "Seu e-mail"
    },
    {
      "type": "text",
      "id": "btn_text",
      "label": "Texto do botão",
      "default": "Assinar"
    },
    {
      "type": "text",
      "id": "success_message",
      "label": "Mensagem de sucesso",
      "default": "Obrigado por se inscrever!"
    },
    {
      "type": "color",
      "id": "bg_color",
      "label": "Cor de fundo",
      "default": "#ffe0cc"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Cor do texto",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "btn_color",
      "label": "Cor do botão",
      "default": "#a0522d"
    }
  ],
  "presets": [
    {
      "name": "Newsletter",
      "settings": {
        "titulo": "Assine nossa newsletter",
        "subtitulo": "Receba novidades e promoções exclusivas"
      }
    }
  ]
}
{% endschema %}