<!-- Snippet: Mafalda Mascot -->
<div class="mascot-wrapper {{ class }}" style="--mascot-size: {{ size | default: '80px' }}">
  <img 
    src="https://cdn.shopify.com/s/files/1/0781/1681/5088/files/mafalda.png?v=123456" 
    alt="Mascote Mafalda" 
    class="mascot-img"
    width="{{ size | default: '80px' }}"
    height="{{ size | default: '80px' }}"
    loading="eager"
  />
</div>

<style>
  .mascot-wrapper {
    display: inline-block;
    width: var(--mascot-size);
    height: var(--mascot-size);
    transition: transform 0.3s ease;
  }

  .mascot-wrapper:hover {
    transform: scale(1.05) rotate(-2deg);
  }

  .mascot-img {
    width: 100%;
    height: auto;
    object-fit: contain;
  }
</style>
